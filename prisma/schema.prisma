// MySQL/MariaDB schema replacing Firestore. Mirrors src/lib/types.ts.
//
// Conventions:
// - Primary keys keep the original Firestore document ids (and Firebase Auth
//   uids for users), so existing URLs, notification links and cross-references
//   survive the migration unchanged. New rows get a cuid().
// - Anything the app filters, sorts or joins on is a real column/table.
//   Small nested lists that are only ever read together with their parent
//   (steps, gallery, skills, option groups, order line items...) stay as JSON.
// - Enum-like fields whose values are Spanish labels with spaces/accents
//   (legalForm, employmentType, academicLevel...) are plain strings, validated
//   in the app like today.

generator client {
  provider      = "prisma-client-js"
  // native = this dev machine; rhel-* = the Namecheap (CloudLinux) server.
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Users

enum UserRole {
  admin
  manager
  editor
  pharmacist
  user
}

model User {
  id                   String    @id @default(cuid()) @db.VarChar(128)
  email                String    @unique @db.VarChar(255)
  displayName          String    @db.VarChar(255)
  photoURL             String?   @db.Text
  title                String?   @db.VarChar(255)
  twitter              String?   @db.VarChar(255)
  linkedin             String?   @db.VarChar(255)
  role                 UserRole  @default(user)
  isPremium            Boolean   @default(false)
  isActive             Boolean   @default(true)
  notificationSettings Json?
  createdAt            DateTime? @db.DateTime(3)

  favorites            UserFavorite[]
  subscriptions        UserSubscription[]
  fcmTokens            FcmToken[]
  notifications        Notification[]
  companies            Company[]             @relation("CompanyOwner")
  professionals        Professional[]
  posts                Post[]
  postComments         PostComment[]
  itineraries          Itinerary[]
  claims               Claim[]
  foodOrders           FoodOrder[]
  shopOrders           ShopOrder[]
  rentalBookings       RentalBooking[]
  companyVerifications CompanyVerification[]
  claimCodes           ClaimCode[]

  @@map("users")
}

enum FavoriteType {
  companies
  procedures
  institutions
  jobs
  events
  places
  itineraries
  professionals
  products
  rentals
}

// Replaces AppUser.favorites.{companies,procedures,...}: string[]
model UserFavorite {
  userId    String       @db.VarChar(128)
  type      FavoriteType
  entityId  String       @db.VarChar(128)
  createdAt DateTime     @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, entityId])
  @@index([type, entityId])
  @@map("user_favorites")
}

enum SubscriptionKind {
  company
  category
}

// Replaces AppUser.subscriptions.{companies,categories}: string[]
// (queried with array-contains in Firestore → needs its own indexed table).
model UserSubscription {
  userId String           @db.VarChar(128)
  kind   SubscriptionKind
  value  String           @db.VarChar(255) // company id or category name

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, value])
  @@index([kind, value])
  @@map("user_subscriptions")
}

model FcmToken {
  token     String   @id @db.VarChar(512)
  userId    String   @db.VarChar(128)
  createdAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

model Notification {
  id        String   @id @default(cuid()) @db.VarChar(128)
  userId    String   @db.VarChar(128)
  message   String   @db.Text
  link      String   @db.VarChar(1024)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------- Shared

// One table for the Branch[] embedded in companies, institutions and
// health facilities. Exactly one of the three owner FKs is set.
model Branch {
  id               String  @id @default(cuid()) @db.VarChar(128)
  companyId        String? @db.VarChar(128)
  institutionId    String? @db.VarChar(128)
  healthFacilityId String? @db.VarChar(128)
  position         Int     @default(0) // keeps the original array order
  name             String  @db.VarChar(255)
  address          String  @db.VarChar(512)
  city             String  @db.VarChar(128)
  lat              Float?
  lng              Float?
  phone            String? @db.VarChar(64)
  email            String? @db.VarChar(255)
  workingHours     Json // {day, hours}[]
  servicesOffered  Json // string[] of Service ids

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  institution    Institution?    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  healthFacility HealthFacility? @relation(fields: [healthFacilityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([institutionId])
  @@index([healthFacilityId])
  @@index([city])
  @@map("branches")
}

enum ReviewTarget {
  company
  institution
  procedure
  professional
  touristLocation
  itinerary
  product
  rental
}

// One table for the Review[] embedded in six entity types. Polymorphic
// (targetType + targetId), so no FK — deleting the parent deletes its
// reviews in app code.
model Review {
  id                 String       @id @default(cuid()) @db.VarChar(128)
  targetType         ReviewTarget
  targetId           String       @db.VarChar(128)
  author             String       @db.VarChar(255)
  authorId           String?      @db.VarChar(128)
  rating             Int
  comment            String       @db.Text
  date               DateTime     @db.DateTime(3)
  source             String?      @db.VarChar(32) // 'google' for imported reviews
  replyText          String?      @db.Text
  replyDate          DateTime?    @db.DateTime(3)
  isVerifiedPurchase Boolean      @default(false) // product reviews: author received the product

  @@index([targetType, targetId])
  @@map("reviews")
}

// ---------------------------------------------------------------- Companies

model Company {
  id               String    @id @default(cuid()) @db.VarChar(128)
  ownerId          String?   @db.VarChar(128)
  name             String    @db.VarChar(255)
  legalForm        String?   @db.VarChar(128)
  cif              String?   @db.VarChar(64)
  logo             String?   @db.Text
  image            String?   @db.Text
  category         String    @db.VarChar(255)
  description      String    @db.Text
  email            String?   @db.VarChar(255)
  website          String?   @db.VarChar(512)
  socialMedia      Json? // {linkedin, facebook, twitter, instagram, tiktok, whatsapp}
  products         Json // Product[]
  highlights       Json // CompanyHighlight[]
  documents        Json // Document[]
  gallery          Json // string[]
  yearEstablished  Int?
  isVerified       Boolean   @default(false)
  verifiedUntil    DateTime? @db.DateTime(3) // the badge lapses after this (re-verify yearly); null = no expiry
  isFeatured       Boolean   @default(false)
  isActive         Boolean   @default(true)
  isPremium        Boolean   @default(false)
  companySize      String?   @db.VarChar(64)
  capitalOwnership String?   @db.VarChar(64)
  geographicScope  String?   @db.VarChar(64)
  purpose          String?   @db.VarChar(64)
  fiscalRegime     String?   @db.VarChar(64)
  googlePlaceId    String?   @unique @db.VarChar(255)
  createdAt        DateTime  @default(now()) @db.DateTime(3)

  owner          User?                 @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branches       Branch[]
  announcements  CompanyAnnouncement[]
  offers         CompanyOffer[]
  claims         Claim[]
  jobPostings    JobPosting[]
  menuItems      MenuItem[]
  foodOrders     FoodOrder[]
  touristLinks   TouristLocation[]
  shopProducts   Product[] // `products` above is the legacy JSON showcase list
  shopOrders     ShopOrder[]
  shopSettings   ShopSettings?
  coupons        Coupon[]
  rentalListings RentalListing[]
  rentalBookings RentalBooking[]
  verifications  CompanyVerification[]
  claimCodes     ClaimCode[]

  @@index([ownerId])
  @@index([category])
  @@index([name])
  @@map("companies")
}

model CompanyAnnouncement {
  id        String   @id @default(cuid()) @db.VarChar(128)
  companyId String   @db.VarChar(128)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  image     String?  @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_announcements")
}

model CompanyOffer {
  id          String    @id @default(cuid()) @db.VarChar(128)
  companyId   String    @db.VarChar(128)
  title       String    @db.VarChar(255)
  description String    @db.Text
  discount    String    @db.VarChar(128)
  validUntil  DateTime? @db.DateTime(3) // null = no expiry date
  image       String?   @db.Text
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([validUntil])
  @@map("company_offers")
}

enum ClaimStatus {
  pending
  approved
  rejected
}

// "Negocio verificado": the owner sends proof (business registration or
// licence + their ID); staff review it. Files live in the private uploads
// folder, never under the public web root.
enum VerificationStatus {
  pending
  approved
  rejected
}

model CompanyVerification {
  id         String             @id @default(cuid()) @db.VarChar(128)
  companyId  String             @db.VarChar(128)
  userId     String             @db.VarChar(128)
  status     VerificationStatus @default(pending)
  documents  Json // {kind: 'business' | 'identity', key, name}[]
  note       String?            @db.Text
  reviewNote String?            @db.Text
  reviewedBy String?            @db.VarChar(128)
  reviewedAt DateTime?          @db.DateTime(3)
  createdAt  DateTime           @default(now()) @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([companyId])
  @@map("company_verifications")
}

// One-time codes emailed to the address already on a company's listing, so a
// claimant can prove they control it and take ownership without waiting
// for staff.
model ClaimCode {
  id        String    @id @default(cuid()) @db.VarChar(128)
  companyId String    @db.VarChar(128)
  userId    String    @db.VarChar(128)
  codeHash  String    @db.VarChar(128)
  sentTo    String    @db.VarChar(255)
  attempts  Int       @default(0)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@map("claim_codes")
}

model Claim {
  id          String      @id @default(cuid()) @db.VarChar(128)
  companyId   String      @db.VarChar(128)
  companyName String      @db.VarChar(255)
  userId      String      @db.VarChar(128)
  userName    String      @db.VarChar(255)
  userEmail   String      @db.VarChar(255)
  status      ClaimStatus @default(pending)
  createdAt   DateTime    @default(now()) @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([companyId])
  @@index([userId])
  @@map("claims")
}

// Shared service catalog (Service type)
model Service {
  id          String @id @default(cuid()) @db.VarChar(128)
  name        String @db.VarChar(255)
  description String @db.Text
  category    String @db.VarChar(255)

  @@index([category])
  @@index([name])
  @@map("services")
}

// ---------------------------------------------------------------- Institutions

model Institution {
  id                     String  @id @default(cuid()) @db.VarChar(128)
  name                   String  @db.VarChar(255)
  logo                   String? @db.Text
  image                  String? @db.Text
  category               String  @db.VarChar(255)
  description            String  @db.Text
  responsiblePersonName  String? @db.VarChar(255)
  responsiblePersonTitle String? @db.VarChar(255)
  email                  String? @db.VarChar(255)
  website                String? @db.VarChar(512)
  whatsapp               String? @db.VarChar(64)

  branches   Branch[]
  procedures Procedure[] // replaces Institution.procedures: derived from Procedure.institutionId

  @@index([category])
  @@map("institutions")
}

model Procedure {
  id              String  @id @default(cuid()) @db.VarChar(128)
  name            String  @db.VarChar(255)
  category        String  @db.VarChar(255)
  description     String  @db.Text
  institutionId   String? @db.VarChar(128)
  institutionName String  @db.VarChar(255) // Procedure.institution (denormalized name)
  requirements    Json // string[]
  steps           Json // {step, description, location}[]
  cost            String  @db.VarChar(255)
  documents       Json // Document[]

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([category])
  @@map("procedures")
}

// ---------------------------------------------------------------- Jobs & events

enum JobStatus {
  open
  closed
}

enum ApplicationMethod {
  email
  link
}

model JobPosting {
  id                      String            @id @default(cuid()) @db.VarChar(128)
  companyId               String            @db.VarChar(128)
  companyName             String            @db.VarChar(255)
  companyLogo             String?           @db.Text
  ownerId                 String            @db.VarChar(128)
  title                   String            @db.VarChar(255)
  description             String            @db.Text
  sector                  String            @db.VarChar(255)
  city                    String            @db.VarChar(128)
  employmentType          String            @db.VarChar(64)
  salaryRange             String?           @db.VarChar(255)
  requirements            Json // string[]
  responsibilities        Json // string[]
  academicLevel           String?           @db.VarChar(64)
  experience              Json // string[]
  skills                  Json // string[]
  applicationMethod       ApplicationMethod
  applicationValue        String            @db.VarChar(512)
  applicationInstructions String?           @db.Text
  status                  JobStatus         @default(open)
  deadline                DateTime?         @db.DateTime(3)
  applicationClickCount   Int               @default(0)
  createdAt               DateTime          @default(now()) @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([companyId])
  @@index([ownerId])
  @@map("job_postings")
}

enum EventOrganizerType {
  company
  institution
}

enum EventRegistrationMethod {
  email
  link
  none
}

enum EventStatus {
  scheduled
  cancelled
}

model Event {
  id                 String                  @id @default(cuid()) @db.VarChar(128)
  title              String                  @db.VarChar(255)
  description        String                  @db.Text
  category           String                  @db.VarChar(255)
  city               String                  @db.VarChar(128)
  address            String?                 @db.VarChar(512)
  startDate          DateTime                @db.DateTime(3)
  endDate            DateTime?               @db.DateTime(3)
  organizerType      EventOrganizerType
  organizerId        String                  @db.VarChar(128) // company or institution id
  organizerName      String                  @db.VarChar(255)
  organizerLogo      String?                 @db.Text
  ownerId            String?                 @db.VarChar(128)
  registrationMethod EventRegistrationMethod @default(none)
  registrationValue  String?                 @db.VarChar(512)
  status             EventStatus             @default(scheduled)
  createdAt          DateTime                @default(now()) @db.DateTime(3)

  @@index([status, startDate])
  @@index([organizerType, organizerId])
  @@index([ownerId])
  @@map("events")
}

// ---------------------------------------------------------------- Tourism

enum ModerationStatus {
  pending
  approved
  rejected
}

model TouristLocation {
  id              String           @id @default(cuid()) @db.VarChar(128)
  name            String           @db.VarChar(255)
  description     String           @db.Text
  category        String           @db.VarChar(128)
  address         String           @db.VarChar(512)
  city            String           @db.VarChar(128)
  lat             Float?
  lng             Float?
  image           String?          @db.Text
  gallery         Json // string[]
  priceRange      String?          @db.VarChar(8) // 'free' | '$' | '$$' | '$$$'
  openingHours    Json // {day, hours}[]
  linkedCompanyId String?          @db.VarChar(128)
  status          ModerationStatus @default(pending)
  submittedBy     String           @db.VarChar(128)
  isFeatured      Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.DateTime(3)

  linkedCompany Company? @relation(fields: [linkedCompanyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([city])
  @@map("tourist_locations")
}

enum ItineraryVisibility {
  public
  unlisted
}

model Itinerary {
  id           String              @id @default(cuid()) @db.VarChar(128)
  title        String              @db.VarChar(255)
  description  String              @db.Text
  coverImage   String?             @db.Text
  authorId     String              @db.VarChar(128)
  authorName   String              @db.VarChar(255)
  city         String              @db.VarChar(128)
  durationDays Int
  theme        Json // string[]
  visibility   ItineraryVisibility @default(public)
  isFeatured   Boolean             @default(false)
  createdAt    DateTime            @default(now()) @db.DateTime(3)

  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stops  ItineraryStop[]

  @@index([visibility])
  @@index([authorId])
  @@map("itineraries")
}

enum ItineraryStopLocationType {
  place
  company
}

model ItineraryStop {
  id            String                    @id @default(cuid()) @db.VarChar(128)
  itineraryId   String                    @db.VarChar(128)
  locationId    String                    @db.VarChar(128) // TouristLocation or Company id
  locationType  ItineraryStopLocationType @default(place)
  order         Int
  day           Int
  suggestedTime String?                   @db.VarChar(64)
  notes         String?                   @db.Text

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@map("itinerary_stops")
}

// ---------------------------------------------------------------- Health

enum HealthFacilityType {
  hospital
  clinic
  pharmacy
}

enum HealthFacilityOwnership {
  public
  private
}

model HealthFacility {
  id                String                  @id @default(cuid()) @db.VarChar(128)
  type              HealthFacilityType
  name              String                  @db.VarChar(255)
  ownership         HealthFacilityOwnership
  description       String                  @db.Text
  services          Json // string[] of Service ids
  specialties       Json // string[]
  emergencyServices Boolean                 @default(false)
  whatsapp          String?                 @db.VarChar(64)
  image             String?                 @db.Text
  isVerified        Boolean                 @default(false)
  isFeatured        Boolean                 @default(false)
  createdAt         DateTime                @default(now()) @db.DateTime(3)

  branches    Branch[]
  onDutyDates PharmacyDutyDate[]

  @@index([type])
  @@map("health_facilities")
}

// Replaces HealthFacility.onDutyDates: string[] (queried with array-contains)
model PharmacyDutyDate {
  facilityId String   @db.VarChar(128)
  date       DateTime @db.Date

  facility HealthFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([facilityId, date])
  @@index([date])
  @@map("pharmacy_duty_dates")
}

// ---------------------------------------------------------------- Professionals

enum ProfessionalAvailability {
  Disponible
  Ocupado
  A_demanda  @map("A demanda")
}

model Professional {
  id           String                    @id @default(cuid()) @db.VarChar(128)
  ownerId      String                    @db.VarChar(128)
  displayName  String                    @db.VarChar(255)
  title        String                    @db.VarChar(255)
  photo        String?                   @db.Text
  bio          String                    @db.Text
  category     String                    @db.VarChar(255)
  skills       Json // string[]
  services     Json // ProfessionalService[]
  portfolio    Json // string[]
  city         String                    @db.VarChar(128)
  availability ProfessionalAvailability?
  phone        String?                   @db.VarChar(64)
  whatsapp     String?                   @db.VarChar(64)
  email        String?                   @db.VarChar(255)
  linkedin     String?                   @db.VarChar(512)
  isVerified   Boolean                   @default(false)
  createdAt    DateTime                  @default(now()) @db.DateTime(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([category])
  @@map("professionals")
}

// ---------------------------------------------------------------- Blog

enum PostStatus {
  draft
  pending
  published
}

model Post {
  id               String     @id @default(cuid()) @db.VarChar(128)
  slug             String     @unique @db.VarChar(255)
  title            String     @db.VarChar(255)
  content          String     @db.LongText
  excerpt          String     @db.Text
  featuredImage    String?    @db.Text
  imageDescription String?    @db.VarChar(512)
  authorId         String     @db.VarChar(128)
  authorName       String     @db.VarChar(255)
  category         String?    @db.VarChar(255)
  status           PostStatus @default(draft)
  createdAt        DateTime   @default(now()) @db.DateTime(3)
  updatedAt        DateTime   @updatedAt @db.DateTime(3)

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments PostComment[]

  @@index([status, createdAt])
  @@map("posts")
}

model PostComment {
  id         String   @id @default(cuid()) @db.VarChar(128)
  postId     String   @db.VarChar(128)
  userId     String   @db.VarChar(128)
  authorName String   @db.VarChar(255)
  comment    String   @db.Text
  createdAt  DateTime @default(now()) @db.DateTime(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_comments")
}

// ---------------------------------------------------------------- Food

model MenuItem {
  id           String   @id @default(cuid()) @db.VarChar(128)
  companyId    String   @db.VarChar(128)
  companyName  String   @db.VarChar(255)
  ownerId      String   @db.VarChar(128)
  name         String   @db.VarChar(255)
  description  String   @db.Text
  price        Decimal  @db.Decimal(12, 2)
  image        String?  @db.Text
  foodType     String   @db.VarChar(128)
  isMenuDelDia Boolean  @default(false)
  available    Boolean  @default(true)
  optionGroups Json // MenuItemOptionGroup[]
  createdAt    DateTime @default(now()) @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([available, isMenuDelDia])
  @@map("menu_items")
}

enum FoodOrderDeliveryMethod {
  pickup
  situka
}

enum FoodOrderPaymentMethod {
  none
  muni_dinero
}

enum FoodOrderPaymentStatus {
  not_applicable
  pending
  paid
}

enum FoodOrderStatus {
  placed
  confirmed
  preparing
  ready
  completed
  cancelled
}

model FoodOrder {
  id                String                  @id @default(cuid()) @db.VarChar(128)
  companyId         String                  @db.VarChar(128)
  companyName       String                  @db.VarChar(255)
  customerId        String?                 @db.VarChar(128)
  customerName      String                  @db.VarChar(255)
  customerPhone     String                  @db.VarChar(64)
  items             Json // FoodOrderItem[] — price/name snapshot at order time
  subtotal          Decimal                 @db.Decimal(12, 2)
  deliveryMethod    FoodOrderDeliveryMethod
  deliveryAddress   String?                 @db.VarChar(512)
  paymentMethod     FoodOrderPaymentMethod  @default(none)
  paymentStatus     FoodOrderPaymentStatus  @default(not_applicable)
  commissionPercent Decimal                 @db.Decimal(5, 2)
  commissionAmount  Decimal                 @db.Decimal(12, 2)
  status            FoodOrderStatus         @default(placed)
  notes             String?                 @db.Text
  createdAt         DateTime                @default(now()) @db.DateTime(3)

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([customerId])
  @@map("food_orders")
}

// ---------------------------------------------------------------- Shop
//
// Multi-seller marketplace. Every product has at least one ProductVariant
// (a single "default" variant when it has no options), so price and stock
// always live on the variant and cart/order code never special-cases
// products without options. Product.minPrice/maxPrice/totalStock/isOnSale
// are denormalised from the variants (recomputed on every write) so the
// storefront can filter and sort without joining.

// Admin-managed category tree (e.g. Electrónica › Móviles › Accesorios).
model ProductCategory {
  id          String   @id @default(cuid()) @db.VarChar(128)
  parentId    String?  @db.VarChar(128)
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  image       String?  @db.Text
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("ProductCategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("product_categories")
}

enum ProductStatus {
  draft
  active
  archived
}

enum ProductCondition {
  new
  used
  refurbished
}

model Product {
  id               String           @id @default(cuid()) @db.VarChar(128)
  companyId        String           @db.VarChar(128)
  categoryId       String?          @db.VarChar(128)
  title            String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  shortDescription String?          @db.VarChar(512)
  description      String           @db.Text
  brand            String?          @db.VarChar(128)
  condition        ProductCondition @default(new)
  status           ProductStatus    @default(draft)
  options          Json // {name, values: string[]}[] — e.g. Talla: S/M/L; variants pick one value per option
  specs            Json // {name, value}[] — technical sheet
  tags             Json // string[]
  // Denormalised from active variants (see header comment).
  minPrice         Decimal          @default(0) @db.Decimal(12, 2)
  maxPrice         Decimal          @default(0) @db.Decimal(12, 2)
  totalStock       Int              @default(0) // sum over variants that track inventory
  inStock          Boolean          @default(false) // any active variant purchasable (stock > 0, untracked or backorder)
  isOnSale         Boolean          @default(false)
  isFeatured       Boolean          @default(false) // set by admins only
  ratingAvg        Decimal          @default(0) @db.Decimal(3, 2)
  ratingCount      Int              @default(0)
  salesCount       Int              @default(0)
  viewCount        Int              @default(0)
  publishedAt      DateTime?        @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  inventoryMovements InventoryMovement[]
  orderItems         ShopOrderItem[]
  questions          ProductQuestion[]

  @@index([companyId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([status, minPrice])
  @@index([status, isFeatured])
  @@index([status, inStock])
  @@index([brand])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid()) @db.VarChar(128)
  productId String  @db.VarChar(128)
  url       String  @db.Text
  alt       String? @db.VarChar(255)
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductVariant {
  id             String   @id @default(cuid()) @db.VarChar(128)
  productId      String   @db.VarChar(128)
  title          String   @db.VarChar(255) // "Rojo / M", or "Estándar" for the default variant
  optionValues   Json // string[] aligned with Product.options order; [] for the default variant
  sku            String?  @db.VarChar(64)
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2) // previous price, shown struck through when > price
  stock          Int      @default(0)
  trackInventory Boolean  @default(true) // false = unlimited (services, made to order)
  allowBackorder Boolean  @default(false) // sell even when stock reaches 0
  image          String?  @db.Text
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime(3)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  orderItems         ShopOrderItem[]

  @@index([productId, position])
  @@index([sku])
  @@map("product_variants")
}

enum InventoryReason {
  initial
  adjustment
  sale
  cancellation
  return
}

// Audit log of every stock change. Deleting a variant only nulls variantId
// (SetNull) so the product's stock history survives variant edits.
model InventoryMovement {
  id         String          @id @default(cuid()) @db.VarChar(128)
  productId  String          @db.VarChar(128)
  variantId  String?         @db.VarChar(128)
  delta      Int
  stockAfter Int
  reason     InventoryReason
  orderId    String?         @db.VarChar(128)
  note       String?         @db.VarChar(512)
  userId     String?         @db.VarChar(128)
  createdAt  DateTime        @default(now()) @db.DateTime(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([variantId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------- Shop orders
//
// One checkout with items from several sellers creates one ShopOrder per
// seller, all sharing a checkoutId (also the secret in the guest
// confirmation link). Line items snapshot title/price at order time so
// later product edits or deletions never rewrite past orders.

// Per-seller delivery/payment options. A missing row means the defaults
// below (pickup only, cash).
model ShopSettings {
  companyId         String   @id @db.VarChar(128)
  pickupEnabled     Boolean  @default(true)
  pickupAddress     String?  @db.VarChar(512) // defaults to the main branch address
  deliveryEnabled   Boolean  @default(false)
  deliveryFee       Decimal  @default(0) @db.Decimal(12, 2) // default fee for any city
  deliveryFeeByCity Json // {city: string, fee: number}[] — overrides; cities not listed use deliveryFee
  deliveryCities    Json // string[] — cities delivered to; [] = all cities
  freeDeliveryOver  Decimal? @db.Decimal(12, 2)
  minOrderAmount    Decimal? @db.Decimal(12, 2)
  acceptsCash       Boolean  @default(true)
  acceptsMuniDinero Boolean  @default(false)
  orderNotes        String?  @db.Text // shown at checkout, e.g. delivery times
  updatedAt         DateTime @updatedAt @db.DateTime(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

enum ShopDeliveryMethod {
  pickup
  delivery
}

enum ShopPaymentMethod {
  cash
  muni_dinero
}

enum ShopPaymentStatus {
  pending
  paid
  refunded
}

enum ShopOrderStatus {
  pending // placed by the customer, awaiting the seller
  confirmed
  processing
  shipped // out for delivery / ready for pickup
  delivered
  cancelled
}

model ShopOrder {
  id                String             @id @default(cuid()) @db.VarChar(128)
  orderNumber       String             @unique @db.VarChar(32) // human-friendly, e.g. OLT-7K2M9Q
  checkoutId        String             @db.VarChar(128)
  companyId         String             @db.VarChar(128)
  companyName       String             @db.VarChar(255)
  customerId        String?            @db.VarChar(128)
  customerName      String             @db.VarChar(255)
  customerPhone     String             @db.VarChar(64)
  customerEmail     String?            @db.VarChar(255)
  deliveryMethod    ShopDeliveryMethod
  deliveryCity      String?            @db.VarChar(128)
  deliveryAddress   String?            @db.VarChar(512)
  paymentMethod     ShopPaymentMethod
  paymentStatus     ShopPaymentStatus  @default(pending)
  status            ShopOrderStatus    @default(pending)
  subtotal          Decimal            @db.Decimal(12, 2)
  deliveryFee       Decimal            @default(0) @db.Decimal(12, 2)
  discount          Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  // Platform commission snapshot, deducted from what the seller nets.
  commissionPercent Decimal            @default(0) @db.Decimal(5, 2)
  commissionAmount  Decimal            @default(0) @db.Decimal(12, 2)
  notes             String?            @db.Text
  cancelReason      String?            @db.VarChar(512)
  couponId          String?            @db.VarChar(128)
  couponCode        String?            @db.VarChar(64)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer User?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    ShopOrderItem[]
  events   ShopOrderEvent[]
  coupon   Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([checkoutId])
  @@index([status, createdAt])
  @@map("shop_orders")
}

model ShopOrderItem {
  id            String  @id @default(cuid()) @db.VarChar(128)
  orderId       String  @db.VarChar(128)
  productId     String? @db.VarChar(128)
  variantId     String? @db.VarChar(128)
  productTitle  String  @db.VarChar(255)
  productSlug   String? @db.VarChar(255)
  variantTitle  String  @db.VarChar(255)
  sku           String? @db.VarChar(64)
  image         String? @db.Text
  unitPrice     Decimal @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal @db.Decimal(12, 2)
  // Whether stock was taken for this line (tracked variant) — so a
  // cancellation puts back exactly what the order took.
  stockReserved Boolean @default(false)

  order   ShopOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("shop_order_items")
}

// Status timeline shown to both seller and customer.
model ShopOrderEvent {
  id        String          @id @default(cuid()) @db.VarChar(128)
  orderId   String          @db.VarChar(128)
  status    ShopOrderStatus
  note      String?         @db.VarChar(512)
  actorId   String?         @db.VarChar(128)
  createdAt DateTime        @default(now()) @db.DateTime(3)

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("shop_order_events")
}

// ---------------------------------------------------------------- Shop engagement

// Public Q&A on a product page; answered by the seller.
model ProductQuestion {
  id         String    @id @default(cuid()) @db.VarChar(128)
  productId  String    @db.VarChar(128)
  authorId   String?   @db.VarChar(128)
  authorName String    @db.VarChar(255)
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime? @db.DateTime(3)
  answeredBy String?   @db.VarChar(128)
  isHidden   Boolean   @default(false) // removed by the seller or a manager
  createdAt  DateTime  @default(now()) @db.DateTime(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isHidden, createdAt])
  @@index([authorId])
  @@map("product_questions")
}

enum CouponType {
  percent
  fixed
}

// Seller discount codes, applied to that seller's part of a checkout.
model Coupon {
  id          String     @id @default(cuid()) @db.VarChar(128)
  companyId   String     @db.VarChar(128)
  code        String     @db.VarChar(64) // stored upper-case
  description String?    @db.VarChar(255)
  type        CouponType
  value       Decimal    @db.Decimal(12, 2) // percent (1-90) or XAF amount
  minSubtotal Decimal?   @db.Decimal(12, 2)
  maxUses     Int? // total redemptions; null = unlimited
  usedCount   Int        @default(0)
  startsAt    DateTime?  @db.DateTime(3)
  endsAt      DateTime?  @db.DateTime(3)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.DateTime(3)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  ShopOrder[]

  @@unique([companyId, code])
  @@map("coupons")
}

// ---------------------------------------------------------------- Rentals
//
// Properties (houses, flats, offices...) and vehicles offered for rent by
// Premium companies. A listing can be rented short-term (per night for
// properties, per day for vehicles, with an availability calendar) and/or
// long-term (per month). Bookings are requests the advertiser accepts or
// rejects; pending and accepted bookings hold their dates. Payment happens
// outside the web, as in the shop.

enum RentalCategory {
  property
  vehicle
}

enum RentalDriverOption {
  none // self-drive only
  optional
  required // always with driver
}

model RentalListing {
  id          String         @id @default(cuid()) @db.VarChar(128)
  companyId   String         @db.VarChar(128)
  slug        String         @unique @db.VarChar(255)
  title       String         @db.VarChar(255)
  description String         @db.Text
  category    RentalCategory
  kind        String         @db.VarChar(64) // piso, casa, oficina... / coche, todoterreno, furgoneta...
  status      ProductStatus  @default(draft)

  // Location (properties: where it is; vehicles: pick-up point)
  city         String  @db.VarChar(128)
  neighborhood String? @db.VarChar(255)
  address      String? @db.VarChar(512)
  lat          Float?
  lng          Float?

  // Pricing: at least one term enabled to publish
  shortTermEnabled Boolean  @default(false)
  dailyPrice       Decimal? @db.Decimal(12, 2) // per night (property) or per day (vehicle)
  minUnits         Int      @default(1) // minimum nights/days
  maxUnits         Int? // maximum nights/days per booking
  longTermEnabled  Boolean  @default(false)
  monthlyPrice     Decimal? @db.Decimal(12, 2)
  minMonths        Int      @default(1)
  deposit          Decimal? @db.Decimal(12, 2) // fianza
  priceNotes       String?  @db.VarChar(512) // gastos incluidos, combustible no incluido...

  // Property details
  bedrooms  Int?
  bathrooms Int?
  areaM2    Int?
  maxGuests Int?
  furnished Boolean?

  // Vehicle details
  brand          String?             @db.VarChar(128)
  model          String?             @db.VarChar(128)
  year           Int?
  transmission   String?             @db.VarChar(32) // manual | automatico
  fuel           String?             @db.VarChar(32) // gasolina | diesel | hibrido | electrico
  seats          Int?
  driverOption   RentalDriverOption?
  driverDailyFee Decimal?            @db.Decimal(12, 2)

  amenities    Json // string[]: aire acondicionado, wifi, parking / GPS, 4x4...
  rules        String?   @db.Text // normas y requisitos (carnet, edad minima...)
  isFeatured   Boolean   @default(false)
  ratingAvg    Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount  Int       @default(0)
  viewCount    Int       @default(0)
  bookingCount Int       @default(0)
  publishedAt  DateTime? @db.DateTime(3)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  images   RentalImage[]
  blocks   RentalBlock[]
  bookings RentalBooking[]

  @@index([status, category, city])
  @@index([companyId, status])
  @@index([status, dailyPrice])
  @@index([status, monthlyPrice])
  @@index([status, isFeatured])
  @@map("rental_listings")
}

model RentalImage {
  id        String @id @default(cuid()) @db.VarChar(128)
  listingId String @db.VarChar(128)
  url       String @db.Text
  position  Int    @default(0)

  listing RentalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@map("rental_images")
}

// Dates the advertiser closes by hand (maintenance, own use, booked
// elsewhere). [startDate, endDate): endDate exclusive, like bookings.
model RentalBlock {
  id        String   @id @default(cuid()) @db.VarChar(128)
  listingId String   @db.VarChar(128)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.DateTime(3)

  listing RentalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate])
  @@map("rental_blocks")
}

enum RentalTerm {
  short
  long
}

enum RentalBookingStatus {
  pending // requested, dates held, awaiting the advertiser
  accepted
  rejected
  cancelled
  completed
}

model RentalBooking {
  id                String              @id @default(cuid()) @db.VarChar(128)
  bookingNumber     String              @unique @db.VarChar(32) // ALQ-7K2M9Q
  accessToken       String              @unique @db.VarChar(64) // secret for the guest link
  listingId         String?             @db.VarChar(128)
  companyId         String              @db.VarChar(128)
  customerId        String?             @db.VarChar(128)
  customerName      String              @db.VarChar(255)
  customerPhone     String              @db.VarChar(64)
  customerEmail     String?             @db.VarChar(255)
  // Snapshot of the listing at request time
  listingTitle      String              @db.VarChar(255)
  listingSlug       String?             @db.VarChar(255)
  listingImage      String?             @db.Text
  category          RentalCategory
  term              RentalTerm
  startDate         DateTime            @db.Date
  endDate           DateTime            @db.Date // exclusive: check-out/return day, or start + months
  units             Int // nights/days (short) or months (long)
  guests            Int?
  withDriver        Boolean             @default(false)
  unitPrice         Decimal             @db.Decimal(12, 2)
  driverFee         Decimal             @default(0) @db.Decimal(12, 2)
  subtotal          Decimal             @db.Decimal(12, 2)
  deposit           Decimal             @default(0) @db.Decimal(12, 2) // refundable, shown apart
  total             Decimal             @db.Decimal(12, 2)
  commissionPercent Decimal             @default(0) @db.Decimal(5, 2)
  commissionAmount  Decimal             @default(0) @db.Decimal(12, 2)
  message           String?             @db.Text
  status            RentalBookingStatus @default(pending)
  ownerNote         String?             @db.VarChar(512)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)

  listing  RentalListing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events   RentalBookingEvent[]

  @@index([listingId, status, startDate])
  @@index([companyId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("rental_bookings")
}

model RentalBookingEvent {
  id        String              @id @default(cuid()) @db.VarChar(128)
  bookingId String              @db.VarChar(128)
  status    RentalBookingStatus
  note      String?             @db.VarChar(512)
  actorId   String?             @db.VarChar(128)
  createdAt DateTime            @default(now()) @db.DateTime(3)

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("rental_booking_events")
}

// ---------------------------------------------------------------- Settings

// Single row (id = 'main'), replaces settings/main.
model SiteSettings {
  id                       String  @id @default("main") @db.VarChar(32)
  siteName                 String  @db.VarChar(255)
  siteSlogan               String  @db.VarChar(512)
  logoUrl                  String? @db.Text
  cities                   Json // string[]
  isBusinessAdvisorEnabled Boolean @default(false)
  socialMedia              Json?
  foodDeliveryFees         Json? // {muniDineroCommissionPercent, situkaCommissionPercent}
  rentalFees               Json? // {commissionPercent}: rentals platform fee
  shopFees                 Json? // {commissionPercent, muniDineroCommissionPercent} — marketplace platform fees
  premiumFeatureRules      Json? // {[feature]: {mode:'all'} | {mode:'categories', categories}} — which categories get each premium feature

  @@map("site_settings")
}
